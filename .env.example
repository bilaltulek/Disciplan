# Local development only. Copy this file to `.env` and replace placeholders.
# Never commit `.env` or paste secret values into source, logs, or chat.

# Pooled Neon connection (hostname contains `-pooler`) for Express/Vercel.
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@POOLED_HOST/DB_NAME?sslmode=require&channel_binding=require

# Direct Neon connection for Trigger/LangGraph and preview migrations.
# The same direct URL is acceptable for both variables on an isolated preview branch.
AGENT_DATABASE_URL=postgresql://WORKER_USER:WORKER_PASSWORD@DIRECT_HOST/DB_NAME?sslmode=require&channel_binding=require
MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:MIGRATION_PASSWORD@DIRECT_HOST/DB_NAME?sslmode=require&channel_binding=require

# Set only while running destructive integration tests against an empty isolated database.
TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@DIRECT_HOST/DB_NAME?sslmode=require&channel_binding=require

# Trigger development dispatch and Gemini preview execution.
TRIGGER_SECRET_KEY=replace_with_trigger_development_secret
TRIGGER_PROJECT_REF=proj_replace_with_runtime_project
# Deployment-time only: uploads the strict allowlist above to the selected
# Trigger project. Never enable this for the protected Production project.
TRIGGER_SYNC_PREVIEW_ENV=false
GEMINI_API_KEY=replace_with_non_production_key
GEMINI_MODEL=gemini-3.1-flash-lite
AI_MAX_OUTPUT_TOKENS=4096

# Preview starts deterministic and advances to shadow/active only after gates pass.
AGENT_ROLLOUT_MODE=off
AGENT_RUNTIME_SCOPE=standard
DISCIPLAN_EXECUTION_RUNTIME=api

# Free-plan preview validation only. Leave disabled for ordinary local use.
# Development validation fails closed unless rollout is off, the data marker is
# isolated-preview, and the two positive-integer user allowlists are disjoint.
AGENT_VALIDATION_MODE=disabled
DISCIPLAN_DATA_ENV=
AGENT_VALIDATION_ACTIVE_USER_IDS=
AGENT_VALIDATION_SHADOW_USER_IDS=
AGENT_VALIDATION_FAULTS_ENABLED=false

# Cost controls. Keep the hard stop below the approved monthly ceiling.
AI_BUDGET_MONTHLY_USD=5
AI_BUDGET_HARD_STOP_USD=4
AI_AGENT_RUN_MAX_RESERVATION_USD=0.10
AGENT_EVAL_MAX_COST_USD=2
# Diagnostic-only controls. Leave unset for the complete release canary.
AGENT_EVAL_CASE_ID=
AGENT_EVAL_DELAY_MS=0

# Required by the deployed Vercel API, not by Trigger task environments.
JWT_SECRET=replace_with_at_least_32_random_characters
